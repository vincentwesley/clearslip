{
  "name": "hush",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest V3 ad and tracker blocker for Chrome that shows what it blocked",
  "type": "module",
  "license": "MIT",
  "author": "Vincent Wesley",
  "repository": "github:vincentwesley/hush",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "knip": "^6.41.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}

